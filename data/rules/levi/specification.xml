  <options>
    <optionGroup id="gameOptions">
      <optionGroup id="gameOptions.map">
        <!-- Row 5: missionaries grant visibility and enhance trade and
             training. -->
        <booleanOption id="model.option.enhancedMissionaries"
                       defaultValue="true"/>
        <!-- House rule: a human player's unit asked whether to learn at
             a native settlement keeps its moves until it accepts, so
             declining ("Handlung abbrechen") or a settlement with
             nothing to teach costs no move.  The original spends the
             move. -->
        <booleanOption id="model.option.cancelKeepsMove"
                       defaultValue="true"/>
        <!-- The original's fortification: a unit whose fortification
             completes at the turn start keeps its moves for that turn
             (opening_014 #2177: the completing unit's block shows
             "Zuege: 1"), so a click frees it and it can move at once.
             FreeCol (classic, freecol) takes the turn's moves. -->
        <booleanOption id="model.option.fortifyKeepsMoves"
                       defaultValue="true"/>
        <!-- The original's treaty breach (clip opening_018, B3): F next
             to a colony of a European we are at peace with asks
             "Wir haben einen Friedensvertrag ..." (@HAVETREATY), and
             "Friedensvertrag brechen." declares war at once; the
             fortified unit occupies the tile, which becomes our land
             ("Neuholland").  Only a human player's units; FreeCol
             (classic, freecol): no war, an occupied tile loses its
             owner. -->
        <booleanOption id="model.option.fortifyDeclaresWar"
                       defaultValue="true"/>
        <!-- The original's arrival in Europe (part T3, Roger's
             screenshots 2026-10-14 in freecol-spike-results\t\
             roger-evidence): a human player's ship arriving in Europe
             puts every unit aboard onto the dock at once, marked "S"
             (boards the next ship that sails); the holds keep only the
             goods.  FreeCol (classic, freecol), AI players and the REF:
             the units stay aboard. -->
        <booleanOption id="model.option.europeArrivalDocks"
                       defaultValue="true"/>
        <!-- The original's sailing time between Europe and the New
             World: two turns each way (landfall: off the map in 1503,
             in Amsterdam at the start of 1505; clip008: off the map in
             1513, in Amsterdam in 1515, and from Amsterdam in 1508,
             back on the map in 1510).  Classic and freecol: 3. -->
        <integerOption id="model.option.turnsToSail"
                       defaultValue="2" minimumValue="1" maximumValue="10"/>
      </optionGroup>
      <optionGroup id="gameOptions.colony">
        <!-- The original's jobs after a move on the colony screen (part
             U, build spec M4.8 R2/R3; clip 020 C5, C10, C14, dago D3): a
             colonist dragged from a building onto a work tile becomes a
             Farmer, whatever the tile or his expertise; one dragged from
             tile to tile keeps his job, even where it makes nothing.
             FreeCol (classic, freecol): the colony chooses the work. -->
        <booleanOption id="model.option.originalDropJobs"
                       defaultValue="true"/>
        <!-- The original's price for KAUFEN on the colony screen (part V,
             build spec M4.10 R1; part X): 13 per missing hammer and 6 per
             missing tool, all doubled while no hammer of the build is
             stored yet.  All 23 KAUFEN boxes of Roger's playthrough 4
             fit (clip 048 #70208: 4760 = 2 x (13 x 160 + 6 x 50), the
             hammer area empty; 046 #119741: 484 = 13 x 28 + 6 x 20; 048
             #102145: 300 = 6 x 50), and so do clip 020 #94078 (494 = 13 x
             38) and dago-colony2 (1248 = 13 x 96).  Amsterdam's tools
             stood at 1/2 the whole time: whether the 6 follows the
             market is not seen (I).  FreeCol (classic, freecol): 20 per
             hammer, the tools at the market's ask plus 10 %. -->
        <booleanOption id="model.option.originalBuildPrice"
                       defaultValue="true"/>
        <!-- The original's completed build (part V, build spec M4.10 R4;
             clip 020 #113, #159, #229): a building finished while nothing
             else is queued stays the current build, «(ABGESCHLOSSEN)»,
             until the player chooses another; no turn warns that nothing
             is built meanwhile.  A finished unit is built again (FreeCol
             already does that with one unit queued).  FreeCol (classic,
             freecol): the finished building leaves the queue. -->
        <booleanOption id="model.option.originalBuildCompletion"
                       defaultValue="true"/>
        <!-- The original's colony reports at the turn start (part W,
             build spec M4.11): @NEEDTOOLS every turn while a build has all
             its hammers and lacks tools (clip 020 #35, #69, #75, #85, #91),
             @CARGOREADY0-2 when a good's stock passes a multiple of 100
             (clip 020 #236, #274, #283; clip 040 #84 666).  FreeCol
             (classic, freecol): a warning when nobody makes the missing
             goods, and at a store's high-water mark or capacity. -->
        <booleanOption id="model.option.originalColonyReports"
                       defaultValue="true"/>
        <!-- The original's docking (part W, build spec M4.12 rule R5;
             clip008 #29957 -> #32928, "Züge: 0"): a ship of ours that
             sails into one of our colonies has no moves left; it sails on
             next turn.  FreeCol (classic, freecol): only the move's cost. -->
        <booleanOption id="model.option.dockingEndsMoves"
                       defaultValue="true"/>
        <!-- The original's colony production (part X, spec
             freecol-spike-results\x-prep\production-rules.md; seven
             colonies of the clips and dago's save COLONY00).  Classic and
             freecol keep FreeCol's yields; they have none of these
             options.
             The colony's centre square: FreeCol's unattended value + 2
             food and + 1 of the second good, then the plow, the
             resource and the Sons of Liberty as FreeCol has them (clip
             020 #2260 swamp, plowed and with a road: 6 food + 3 sugar,
             FreeCol 4 + 2; #14817 rain forest 4 + 2; #123003 broadleaf
             4 + 3 furs; clip008 #4032 conifer 4 + 3; dago's Fur Town at
             100 % 6 + 5).  Only the colony's own centre: the natives'
             land is not touched. -->
        <booleanOption id="model.option.originalColonyCenter"
                       defaultValue="true"/>
        <!-- Lumber: an expert lumberjack gets a road's + 2 once, not
             doubled (clip 020 #75440: 10 on tropical forest with a road,
             a colonist 6 there, #93178; FreeCol 12); the Sons of Liberty
             bonus counts twice for lumber (dago's Fur Town E: 22 at
             100 %, FreeCol 20; its Base NE 30 with prime timber; I+). -->
        <booleanOption id="model.option.originalLumber"
                       defaultValue="true"/>
        <!-- The expert fisherman: + 2 fish, not FreeCol's + 3 (clip 020
             #46108 and #134173: 6 on a coastal ocean square where a
             colonist makes 4; clip 048 #13896: 12 on a fishery where an
             expert farmer makes 7; dago: 10 at 100 %). -->
        <booleanOption id="model.option.originalFisherman"
                       defaultValue="true"/>
        <!-- The horses: half the food surplus, rounded up (dago's Fur
             City: a surplus of 1 breeds 1 horse; Fur Town: 21 gives 11,
             10 stored); FreeCol rounds down. -->
        <booleanOption id="model.option.originalHorseFood"
                       defaultValue="true"/>
        <!-- Roads and silver: a road raises silver only on a square with
             a silver deposit (the manual, p. 27: "Building a road in a
             mountain square does not increase the production of silver
             unless there is a silver deposit in the square"); FreeCol
             everywhere.  A mineral deposit does not count (I). -->
        <booleanOption id="model.option.originalRoadSilver"
                       defaultValue="true"/>
        <!-- Row 8: capture units under repair when a colony is
             captured. -->
        <booleanOption id="model.option.captureUnitsUnderRepair"
                       defaultValue="true"/>
        <!-- Row 11: colonies can be founded during the war of
             independence. -->
        <booleanOption id="model.option.foundColonyDuringRebellion"
                       defaultValue="true"/>
        <!-- Row 12: overflow hammer and cross production is lost. -->
        <booleanOption id="model.option.saveProductionOverflow"
                       defaultValue="false"/>
        <!-- Row 13: the player chooses whom a school teaches. -->
        <booleanOption id="model.option.allowStudentSelection"
                       defaultValue="true"/>
      </optionGroup>
      <optionGroup id="gameOptions.victoryConditions">
        <!-- House rule: after independence the game goes on with no end,
             so neither defeating the REF nor being the last European
             wins it. -->
        <booleanOption id="model.option.victoryDefeatREF"
                       defaultValue="false"/>
        <booleanOption id="model.option.victoryDefeatEuropeans"
                       defaultValue="false"/>
        <!-- House rule: no revenge mode.  A defeat ends the game; it is
             decided by the server alone. -->
        <booleanOption id="model.option.revengeMode"
                       defaultValue="false"/>
        <!-- House rule: a European is defeated when he has no colony
             left: from the mandatory colony year on, and at once after
             declaring independence (not only when his last coastal
             colony is lost).  Before that year he may be without one,
             as in the original. -->
        <booleanOption id="model.option.lastColonyDefeat"
                       defaultValue="true"/>
      </optionGroup>
    </optionGroup>
    <optionGroup id="mapGeneratorOptions">
      <optionGroup id="mapGeneratorOptions.landGenerator">
        <!-- The original's New World (OriginalWorld, LandMap): the
             land grows from random walks, as in Civilization's
             generator, until it has the amount the original gives
             the world questions LANDMASSE and LANDFORM (Roger's 13
             games of 2026-10-13: everything Normal 872 and 901 land
             tiles, Klein 673 and 732, Gross 1079 and 1184,
             Inselgruppe 698, Grosse Kontinente 1191), each map
             varied by 5 %.  Both topologies; landMass is not used.
             The classic and freecol rules keep FreeCol's
             generators. -->
        <selectOption id="model.option.landGeneratorType"
                      defaultValue="4" localizedLabels="true">
          <selectValue label="model.option.landGeneratorType.classic"
                       value="0"/>
          <selectValue label="model.option.landGeneratorType.continent"
                       value="1"/>
          <selectValue label="model.option.landGeneratorType.archipelago"
                       value="2"/>
          <selectValue label="model.option.landGeneratorType.islands"
                       value="3"/>
          <selectValue label="model.option.landGeneratorType.original"
                       value="4"/>
        </selectOption>
        <!-- LANDMASSE (GAME.TXT @CLAND): Klein / Normal / Gross. -->
        <selectOption id="model.option.originalLandMass"
                      defaultValue="1" localizedLabels="true">
          <selectValue label="model.option.originalLandMass.small"
                       value="0"/>
          <selectValue label="model.option.originalLandMass.normal"
                       value="1"/>
          <selectValue label="model.option.originalLandMass.large"
                       value="2"/>
        </selectOption>
        <!-- LANDFORM (GAME.TXT @CCONT): Inselgruppe / Normal / Grosse
             Kontinente. -->
        <selectOption id="model.option.originalLandForm"
                      defaultValue="1" localizedLabels="true">
          <selectValue label="model.option.originalLandForm.islands"
                       value="0"/>
          <selectValue label="model.option.originalLandForm.normal"
                       value="1"/>
          <selectValue label="model.option.originalLandForm.continents"
                       value="2"/>
        </selectOption>
      </optionGroup>
      <optionGroup id="mapGeneratorOptions.terrainGenerator">
        <!-- The original's villages (part P2, OriginalNatives): the
             same on every level (FreeCol spaces them by the level's
             settlementNumber, 10 to 5: 12 to 31 villages); as many as
             the original puts on that much land (Roger's 13 games of
             2026-10-13: 39 to 84, e.g. 60 and 61 with everything
             Normal), each tribe 6 to 21 (Roger 2026-10-13: "fix 6 bis 21
             pro Stamm"; the original gives 1 to 22), at most 84 on a
             map (MAPEDIT.TXT @HELP5), one capital each, never two
             next to each other (spacing 3; a top-up site 2); the Inca
             and Aztec in the west, the Iroquois and Arawak in the east,
             north and south drawn per map, the other four anywhere.
             The classic and freecol rules have none of these options
             and keep FreeCol's placement. -->
        <integerOption id="model.option.nativeSettlementSpacing"
                       defaultValue="3" minimumValue="2" maximumValue="10"/>
        <integerOption id="model.option.nativeSettlementsMinimum"
                       defaultValue="6" minimumValue="1" maximumValue="21"/>
        <integerOption id="model.option.nativeSettlementsMaximum"
                       defaultValue="21" minimumValue="1" maximumValue="99"/>
        <integerOption id="model.option.nativeSettlementsTotal"
                       defaultValue="84" minimumValue="8" maximumValue="999"/>
      </optionGroup>
    </optionGroup>
  </options>
</freecol-specification>
